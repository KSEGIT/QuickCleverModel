; Model presets for llama-server router mode. Rendered to run/models.ini by
; start-server.sh, which substitutes @ROOT@ for the repo path.
;
; Section names ARE the model IDs: server-models.cpp:154 force-sets
; LLAMA_ARG_ALIAS to the section name, so these strings are what appears in
; /v1/models and in the Open WebUI dropdown.
;
; mmproj MUST be declared per-section. On the router's own command line it is
; silently discarded by unset_reserved_args(base_preset, true).
;
; Do NOT add the `version = 1` line from the fork's own README example. Any key
; before the first [section] header lands in a section named "default"
; (preset.cpp:254 initialises current_section to COMMON_PRESET_DEFAULT_NAME).
; `version` is then skipped as reserved, but the empty section survives, the [*]
; globals cascade onto it, and a phantom model with no weights appears in
; /v1/models and in the Open WebUI dropdown.

; Shared by both children. Every value here is measured — see docs/tuning.md.
[*]
ngl = 99
c = @CTX@
parallel = @PARALLEL@
fa = on
; q4_0 KV, not q8_0: measured on THIS fork's Metal kernels (llama-bench, stack
; down, r=3): Q1_0 tg128 16.14 (q4_0) vs 14.06 (q8_0) vs 13.85 (f16) -- +15%.
; Upstream advice says quantized KV is unoptimized on Metal (llama.cpp#23011);
; the prism fork evidently fixed that. Measurement beats citation.
ctk = q4_0
ctv = q4_0
spec-type = @SPEC@
cache-reuse = @CACHE_REUSE@
; llama-server defaults --cache-ram to 8192 MiB. On a 24 GB box already holding
; 6.7 GB of weights wired by Metal, letting the prompt cache grow to 8 GB is
; what pushes the weights out to swap -- measured at 13.5 GB of page-ins during
; a single benchmark run. Capping it keeps multi-turn reuse (a few checkpoints
; of ~150 MiB each) without competing with the weights for RAM.
cache-ram = @CACHE_RAM@
metrics = true
jinja = true
temp = 0.5
top-p = 0.85
top-k = 20
min-p = 0

; 6.7 GB, 94.6% of FP16 per the model card. The default.
[bonsai-27b-ternary]
model = @ROOT@/models/Ternary-Bonsai-27B-gguf/Ternary-Bonsai-27B-Q2_0.gguf
mmproj = @ROOT@/models/Ternary-Bonsai-27B-gguf/Ternary-Bonsai-27B-mmproj-Q8_0.gguf
load-on-startup = true

; 3.8 GB, 89.5% of FP16 per the model card. Loads on first request.
[bonsai-27b-1bit]
model = @ROOT@/models/Bonsai-27B-gguf/Bonsai-27B-Q1_0.gguf
mmproj = @ROOT@/models/Bonsai-27B-gguf/Bonsai-27B-mmproj-Q8_0.gguf
load-on-startup = false
