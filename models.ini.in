; Model presets for llama-server router mode. Rendered to run/models.ini by
; start-server.sh, which substitutes @ROOT@ for the repo path.
;
; Section names ARE the model IDs: server-models.cpp:154 force-sets
; LLAMA_ARG_ALIAS to the section name, so these strings are what appears in
; /v1/models and in the Open WebUI dropdown.
;
; mmproj MUST be declared per-section. On the router's own command line it is
; silently discarded by unset_reserved_args(base_preset, true).
;
; Do NOT add the `version = 1` line from the fork's own README example. Any key
; before the first [section] header lands in a section named "default"
; (preset.cpp:254 initialises current_section to COMMON_PRESET_DEFAULT_NAME).
; `version` is then skipped as reserved, but the empty section survives, the [*]
; globals cascade onto it, and a phantom model with no weights appears in
; /v1/models and in the Open WebUI dropdown.

; Only universal settings belong here. Keep offload, cache, reasoning and
; sampling inside each model section.
[*]
metrics = true
jinja = true

; Every Bonsai section sets chat-template-file. It is NOT in [*]: that block
; cascades onto every section, so a future non-Bonsai model would be rendered
; with Bonsai's ChatML tokens and produce silent garbage -- chat-template-file
; overrides whatever template the GGUF carries.
;
; Why override at all: the template baked into the Bonsai GGUFs renders only
; messages[0] as the system block and raises 'System message must be at the
; beginning.' for any system message after it. Codex sends two, one from the
; Responses API `instructions` field and one from a `developer` input item it
; puts in every request, so every Codex call returned a 400. Our copy renders
; the later blocks instead of raising and is otherwise the same template --
; tests/test_chat_template.py compares whole renders against the GGUF original.

; 6.7 GB, 94.6% of FP16 per the model card. The default.
[bonsai-27b-ternary]
model = @ROOT@/models/Ternary-Bonsai-27B-gguf/Ternary-Bonsai-27B-PQ2_0.gguf
ngl = @NGL@
c = @CTX@
no-kv-offload = @NKVO@
parallel = @PARALLEL@
fa = @FA@
ctk = @CTK@
ctv = @CTV@
ubatch-size = @UBATCH@
reasoning-budget = @REASONING_BUDGET@
spec-type = @SPEC@
spec-ngram-mod-n-match = @NGRAM_MOD_N_MATCH@
spec-ngram-mod-n-min = @NGRAM_MOD_N_MIN@
spec-ngram-mod-n-max = @NGRAM_MOD_N_MAX@
cache-reuse = @CACHE_REUSE@
cache-ram = @CACHE_RAM@
temp = 0.5
top-p = 0.85
top-k = 20
min-p = 0
mmproj = @ROOT@/models/Ternary-Bonsai-27B-gguf/Ternary-Bonsai-27B-mmproj-Q8_0.gguf
chat-template-file = @ROOT@/bonsai-chat-template.jinja
load-on-startup = true

; 3.8 GB, 89.5% of FP16 per the model card. Loads on first request.
[bonsai-27b-1bit]
model = @ROOT@/models/Bonsai-27B-gguf/Bonsai-27B-Q1_0.gguf
ngl = @NGL@
c = @CTX@
no-kv-offload = @NKVO@
parallel = @PARALLEL@
fa = @FA@
ctk = @CTK@
ctv = @CTV@
ubatch-size = @UBATCH@
reasoning-budget = @REASONING_BUDGET@
spec-type = @SPEC@
spec-ngram-mod-n-match = @NGRAM_MOD_N_MATCH@
spec-ngram-mod-n-min = @NGRAM_MOD_N_MIN@
spec-ngram-mod-n-max = @NGRAM_MOD_N_MAX@
cache-reuse = @CACHE_REUSE@
cache-ram = @CACHE_RAM@
temp = 0.5
top-p = 0.85
top-k = 20
min-p = 0
mmproj = @ROOT@/models/Bonsai-27B-gguf/Bonsai-27B-mmproj-Q8_0.gguf
chat-template-file = @ROOT@/bonsai-chat-template.jinja
load-on-startup = false

; New agent presets are text-only. Qwen3.5 uses a copy of its native GGUF
; template with only the late-system-message guard changed: Codex Responses
; sends multiple instruction messages. Other families keep native templates.
; The 8K/f16 defaults are conservative starting points, not an RTX benchmark.
; Each overrides Bonsai's reasoning, speculation and cache configuration.
[qwen3.5-9b-q4_k_m]
model = @ROOT@/models/Qwen3.5-9B-GGUF/Qwen3.5-9B-Q4_K_M.gguf
chat-template-file = @ROOT@/qwen3.5-chat-template.jinja
temp = 0.5
top-p = 0.85
top-k = 20
min-p = 0
c = @QWEN9_CTX@
ngl = @QWEN9_NGL@
fa = @QWEN_FA@
ctk = @QWEN_CTK@
ctv = @QWEN_CTV@
no-kv-offload = false
parallel = 1
ubatch-size = @AGENT_UBATCH@
spec-type = none
cache-reuse = @AGENT_CACHE_REUSE@
cache-ram = @AGENT_CACHE_RAM@
reasoning = @QWEN_REASONING@
reasoning-budget = @QWEN_REASONING_BUDGET@
load-on-startup = false

[granite-4.1-8b-q4_k_m]
model = @ROOT@/models/granite-4.1-8b-GGUF/granite-4.1-8b-Q4_K_M.gguf
temp = 0.5
top-p = 0.85
top-k = 20
min-p = 0
c = @GRANITE_CTX@
ngl = @GRANITE_NGL@
fa = @GRANITE_FA@
ctk = @GRANITE_CTK@
ctv = @GRANITE_CTV@
no-kv-offload = false
parallel = 1
ubatch-size = @AGENT_UBATCH@
spec-type = none
cache-reuse = @AGENT_CACHE_REUSE@
cache-ram = @AGENT_CACHE_RAM@
reasoning = auto
reasoning-budget = -1
load-on-startup = false

[qwen3.5-4b-q4_k_m]
model = @ROOT@/models/Qwen3.5-4B-GGUF/Qwen3.5-4B-Q4_K_M.gguf
chat-template-file = @ROOT@/qwen3.5-chat-template.jinja
temp = 0.5
top-p = 0.85
top-k = 20
min-p = 0
c = @QWEN4_CTX@
ngl = @QWEN4_NGL@
fa = @QWEN_FA@
ctk = @QWEN_CTK@
ctv = @QWEN_CTV@
no-kv-offload = false
parallel = 1
ubatch-size = @AGENT_UBATCH@
spec-type = none
cache-reuse = @AGENT_CACHE_REUSE@
cache-ram = @AGENT_CACHE_RAM@
reasoning = @QWEN_REASONING@
reasoning-budget = @QWEN_REASONING_BUDGET@
load-on-startup = false

; Qwen3.6 MoE hybrid escalation model. With ngl unset, Prism's --fit algorithm
; chooses attention/other GPU tensors and leaves excess experts in system RAM.
; fit-target reserves GPU headroom; do not claim this is tuned for 8 GB yet.
[qwen3.6-35b-a3b]
model = @QWEN36_MODEL@
c = @QWEN36_CTX@
ngl = @QWEN36_NGL@
fit = on
fit-target = @QWEN36_FIT_TARGET@
fa = @QWEN36_FA@
ctk = @QWEN36_CTK@
ctv = @QWEN36_CTV@
no-kv-offload = false
parallel = 1
ubatch-size = @AGENT_UBATCH@
spec-type = none
cache-ram = @AGENT_CACHE_RAM@
reasoning = @QWEN36_REASONING@
reasoning-budget = @QWEN36_REASONING_BUDGET@
load-on-startup = false

; Official QAT text/tool preset; Q5_K_M alternative is selected separately.
[gemma4-e4b]
model = @GEMMA4_MODEL@
c = @GEMMA4_CTX@
ngl = @GEMMA4_NGL@
fa = @GEMMA4_FA@
ctk = @GEMMA4_CTK@
ctv = @GEMMA4_CTV@
no-kv-offload = false
parallel = 1
ubatch-size = @AGENT_UBATCH@
spec-type = none
cache-ram = @AGENT_CACHE_RAM@
reasoning = auto
reasoning-budget = -1
load-on-startup = false

; Text-only Bonsai: no mmproj. Retained as the coding-focused Bonsai alias.
[bonsai-27b-ternary-text]
model = @ROOT@/models/Ternary-Bonsai-27B-gguf/Ternary-Bonsai-27B-PQ2_0.gguf
ngl = @NGL@
no-kv-offload = @NKVO@
parallel = @PARALLEL@
fa = @FA@
ctk = @CTK@
ctv = @CTV@
ubatch-size = @UBATCH@
reasoning-budget = @REASONING_BUDGET@
spec-type = @SPEC@
spec-ngram-mod-n-match = @NGRAM_MOD_N_MATCH@
spec-ngram-mod-n-min = @NGRAM_MOD_N_MIN@
spec-ngram-mod-n-max = @NGRAM_MOD_N_MAX@
cache-reuse = @CACHE_REUSE@
cache-ram = @CACHE_RAM@
temp = 0.5
top-p = 0.85
top-k = 20
min-p = 0
chat-template-file = @ROOT@/bonsai-chat-template.jinja
; Its own context, set by BONSAI_CTX_TEXT and defaulting to BONSAI_CTX.
; Previous runtime measurements with host-side KV at 131072 tokens are
; historical; repeat fit and reliability tests after this Prism upgrade.
c = @CTX_TEXT@
load-on-startup = false
