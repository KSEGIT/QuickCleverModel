# Build context for docker/Dockerfile is the repo root (compose.linux.yaml).
# The image only COPYs startup/version files and the model manifest; it clones
# the fork at the pinned revision
# itself — shipping 16 GB of local artifacts to the daemon on every build
# would be pure waste.
models/
.venv/
src/
bin/
.git
.worktrees/
.webui-data/
.playwright-mcp/
run/
__pycache__/
docker/.env

# secrets — never shipped to the daemon, even unused
.env
.webui_secret_key
