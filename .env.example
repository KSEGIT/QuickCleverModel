# QuickCleverModel — example .env. Copy to .env and edit:
#   cp .env.example .env && chmod 600 .env
# .env is the one source of truth for the whole stack: the native macOS
# scripts, the Linux Docker stack, and setup-opencode.sh all read it.
# Everything below is optional except BONSAI_API_KEY. Defaults shown are
# what the scripts use when the variable is unset — uncomment to change.

# --- required ---------------------------------------------------------------

# API key for llama-server (and Open WebUI, which proxies it). Generate one:
#   printf 'BONSAI_API_KEY=bonsai-%s\n' "$(openssl rand -hex 20)" >> .env
BONSAI_API_KEY=bonsai-change-me

# --- where the server is (client side: setup-opencode.sh, bench.sh) ---------

# Host/IP of the llama-server. 127.0.0.1 when it runs on this machine,
# a Tailscale IP (e.g. 100.109.50.118) when it runs on another box.
# setup-opencode.sh prompts for this if missing.
#BONSAI_HOST=127.0.0.1
#BONSAI_PORT=8080

# --- publishing (Linux Docker path) -----------------------------------------

# Which host IPs the ports listen on. Loopback-only by default; set to a
# Tailscale IP to serve a tailnet. NEVER 0.0.0.0 unless you mean to share
# with the whole LAN — the UI has no login unless WEBUI_AUTH is flipped in
# docker/compose.linux.yaml. The API always requires the key.
#LLAMA_BIND=127.0.0.1
#WEBUI_BIND=127.0.0.1
# Second interface, e.g. a second tailscaled on another tailnet.
#LLAMA_BIND2=127.0.0.2
#WEBUI_BIND2=127.0.0.2
# Open WebUI port on the native macOS path (start-webui.sh).
#WEBUI_PORT=9090

# --- context and memory ------------------------------------------------------

# Context size in tokens. Model trains to 262144. Default 32768 on macOS,
# 8192 in docker/compose.linux.yaml (sized for 8 GB VRAM with KV on GPU).
# Must match between server .env and client .env (opencode compacts at it).
#BONSAI_CTX=8192

# true = KV cache in system RAM, weights stay on GPU. For boxes with little
# VRAM and plenty of RAM (RTX 3070 Ti 8 GB + 64 GB). Slower decode: KV is
# read over PCIe every token.
#BONSAI_NO_KV_OFFLOAD=false

# KV cache quant type. q4_0 is measured-best on Apple Metal (do not change
# for macOS). With host-side KV on Linux, q8_0 can beat q4_0 — the CPU KV
# fast path is gated on non-q4 types.
#BONSAI_CTK=q4_0
#BONSAI_CTV=q4_0

# Micro-batch size; sizes the peak compute buffer. 256 fixes cudaMalloc OOM
# on 8 GB cards at ~25% prefill cost. 512 is the upstream default.
#BONSAI_UBATCH=512

# Prompt cache in RAM, MiB. A 30k-token entry is ~3 GB on this model, so
# raise this for long agent sessions on big-RAM boxes.
#BONSAI_CACHE_RAM=2048
# Prompt-prefix reuse granularity in tokens.
#BONSAI_CACHE_REUSE=256

# How many models stay loaded at once (router mode). 1 = swap on selection,
# 2 = both hot (instant switching, needs the RAM/VRAM).
#BONSAI_MODELS_MAX=1
# Parallel request slots per model.
#BONSAI_PARALLEL=1

# --- generation --------------------------------------------------------------

# Cap on thinking tokens. The think block is closed cleanly when the budget
# runs out. -1 = unlimited, 0 = end thinking at once.
#BONSAI_REASONING_BUDGET=4096

# Speculative decoding. ngram-simple is measured-best on Metal; ngram-mod
# wins on repetitive output (code, tool-call JSON). The three ngram-mod
# tuning flags only apply when BONSAI_SPEC=ngram-mod.
#BONSAI_SPEC=ngram-simple
#BONSAI_NGRAM_MOD_N_MATCH=24
#BONSAI_NGRAM_MOD_N_MIN=48
#BONSAI_NGRAM_MOD_N_MAX=64

# --- Playwright MCP (start-playwright-mcp.sh) --------------------------------

#PW_MCP_PORT=8931
#PW_MCP_BROWSER=chrome
# none = do not attach the page tree to every tool response (huge); the
# model can call browser_snapshot when it needs it.
#PW_MCP_SNAPSHOT=none
# Cap on the total bytes in PW_MCP_OUTPUT_DIR. Once exceeded, the oldest
# artifacts are DELETED. Default 536870912 (512 MiB); set 0 to keep everything
# forever (the directory then grows without bound).
#PW_MCP_OUTPUT_MAX_SIZE=536870912

# Where screenshots and other files the browser tools write are saved.
# Defaults to <repo>/.playwright-mcp, which is gitignored and dockerignored.
# Use an ABSOLUTE path: a relative one resolves against the working directory
# the service was launched from, not the repo, so dumps can land outside the
# ignore rules and end up committed or in the Docker build context.
#PW_MCP_OUTPUT_DIR=/absolute/path/to/playwright-output
