# Weekly update for the Linux/Docker Bonsai stack.
#
# __ROOT__ and __USER__ are placeholders — this file is not usable as-is.
# Install it from the repo root with:
#
#   sed -e "s|__ROOT__|$PWD|g" -e "s|__USER__|$USER|g" \
#       docker/bonsai-update.service | sudo tee /etc/systemd/system/bonsai-update.service
#
# The user must be in the docker group; update.sh talks to the daemon.

[Unit]
Description=Update and verify the Bonsai model stack
# Pulling code and images needs the network, and the smoke test needs the
# published port to be bound.
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/update.sh

# Must cover the WHOLE worst case, including the rollback, or systemd sends
# SIGTERM in the middle of the one path whose job is to rescue the stack.
# Budget, with 3 model aliases at BONSAI_SMOKE_TIMEOUT=900 each:
#   compose build llama   up to 2700s  (Dockerfile builds llama.cpp + CUDA)
#   smoke before update         2700s
#   wait_for_health              180s
#   smoke after update          2700s
#   rollback: health + smoke    2880s
#                              -------
#                              11160s
# 14400 leaves headroom for a slow registry without letting a hung run sit
# there all day. Raising BONSAI_SMOKE_TIMEOUT means raising this too.
TimeoutStartSec=14400

# Deprioritizes THIS unit: the git work, the smoke sweeps and the compose
# client. It does NOT reach the image build — `docker compose build` only
# ships the context to dockerd, and the compile runs in the daemon's own
# process tree and cgroup, which inherits nothing from here. To deprioritize
# the build itself you would have to limit docker.service, or pass
# --cpu-shares/--cpuset-cpus to the build.
Nice=10
IOSchedulingClass=idle

# No [Install] section, on purpose. This unit is started by
# bonsai-update.timer, and that is the unit you enable. With an [Install]
# here, `systemctl enable bonsai-update.service` — a natural thing to type
# after installing the file — would run a full pull, rebuild and smoke sweep
# on every boot, at the worst possible moment: while the GPU stack is still
# coming up and LLAMA_BIND2 may not be bound yet.
