# Weekly update for the Linux/Docker Bonsai stack.
#
# __ROOT__ and __USER__ are placeholders — this file is not usable as-is.
# Install it from the repo root with:
#
#   sed -e "s|__ROOT__|$PWD|g" -e "s|__USER__|$USER|g" \
#       docker/bonsai-update.service | sudo tee /etc/systemd/system/bonsai-update.service
#
# The user must be in the docker group; update.sh talks to the daemon.

[Unit]
Description=Update and verify the Bonsai model stack
# Pulling code and images needs the network, and the smoke test needs the
# published port to be bound.
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/update.sh

# Must cover the WHOLE worst case, including the rollback, or systemd sends
# SIGTERM in the middle of the one path whose job is to rescue the stack.
# Budget, with 3 model aliases at -m 600 each:
#   compose build llama   up to 2700s  (Dockerfile builds llama.cpp + CUDA)
#   smoke before update         1800s
#   wait_for_health              180s
#   smoke after update          1800s
#   rollback: health + smoke    1980s
#                              ------
#                               8460s
# 14400 leaves headroom for a slow registry without letting a hung run sit
# there all day.
TimeoutStartSec=14400

# Build and rollback must not fight the model server for CPU on a box that is
# also serving chat.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
