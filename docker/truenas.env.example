# Copy outside the repository, chmod 600, then fill every blank value.
# See docs/truenas.md for build, render, install and rollback steps.
# Build, load, or pull the image onto TrueNAS before app start.
QCM_IMAGE=

# Absolute paths on the TrueNAS host. Create the directories first.
# QCM_MODELS_PATH contains the model-family directories from fetch-models.sh.
# QCM_PRESET_PATH names the copied docker/models.truenas.ini.in FILE.
# QCM_WEBUI_DATA_PATH is a private persistent directory for users and chats.
QCM_MODELS_PATH=
QCM_PRESET_PATH=
QCM_WEBUI_DATA_PATH=

# Use different long random values. Keep WEBUI_SECRET_KEY across restarts.
# Generate each value with: openssl rand -hex 32
BONSAI_API_KEY=
WEBUI_SECRET_KEY=

# Bind only to addresses already assigned to the host. Defaults are loopback.
# For remote access, replace LLAMA_BIND2/WEBUI_BIND with the host's LAN IPv4
# address, and LLAMA_BIND3/WEBUI_BIND2 with its Tailscale IPv4 address.
LLAMA_BIND=127.0.0.1
LLAMA_BIND2=127.0.0.2
LLAMA_BIND3=127.0.0.3
WEBUI_BIND=127.0.0.1
WEBUI_BIND2=127.0.0.2

# Optional: the defaults use http://WEBUI_BIND:9090 and both UI bind origins.
# If you use DNS or an HTTPS proxy, set the exact URL and all allowed origins.
# Separate CORS origins with semicolons; do not use a wildcard.
#WEBUI_URL=
#CORS_ALLOW_ORIGIN=
